# Sao chép file này thành .env.local khi chạy trên máy của bạn.
# KHÔNG bao giờ commit file .env.local (repo này công khai).

# Bắt buộc: chuỗi kết nối PostgreSQL (Neon, Supabase hoặc Postgres trên máy).
DATABASE_URL=postgres://planner:planner@localhost:5432/planner_dev
# Không bắt buộc: kết nối trực tiếp (không qua pooler) dùng cho migration. Neon tự tạo biến này.
# DATABASE_URL_UNPOOLED=

# Không bắt buộc – nhắc nhở khi ứng dụng đã đóng (Web Push).
# Tạo khóa bằng: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ban@example.com

# Không bắt buộc – bí mật để bộ hẹn giờ gọi /api/cron/reminders (chuỗi ngẫu nhiên dài).
# CRON_SECRET=

# Chỉ khi chạy bản production (npm start) trên http://localhost bằng Safari: cho phép cookie không Secure.
# INSECURE_COOKIES=1
